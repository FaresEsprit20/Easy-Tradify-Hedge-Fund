# ============================================================
# The repository has no .gitignore, and it shows: 132 .pyc files are
# tracked, replay_records.json (multi-MB, regenerated on every run) is
# tracked, and the .git directory has reached 151MB for a project whose
# source is a few MB.
#
# This file stops NEW artifacts being added. It does not untrack what
# is already tracked -- git ignores .gitignore for files it is already
# following. To untrack them without deleting anything on disk:
#
#     git rm -r --cached --quiet .
#     git add .
#     git commit -m "apply .gitignore: untrack build and run artifacts"
#
# Worth reading the resulting diff before committing: that command
# restages the whole tree.
# ============================================================

# --- Python bytecode and build output ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Test and type-checker caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Replay and audit output ---
# Regenerated by core/run_replay.py on every run. replay_records.json
# in particular is multi-megabyte and changes completely each time, so
# tracking it makes every run a large binary-shaped diff.
replay_records.json
replay_report.txt
replay_*.txt
rec_*.json

# --- Cached market data ---
# Downloaded from MT5 and rebuildable with --refresh. The tick archive
# is the exception worth thinking about: unlike the bar cache it CANNOT
# be rebuilt, because MT5 only retains about a week of ticks and the
# archive accumulates beyond that. It is ignored here because it grows
# without bound (hundreds of MB) and git is the wrong tool for it --
# but that means it needs a real backup, not just this line.
replay_bars/
tick_archive/
*.npy

# --- Models and trained artifacts ---
*.pkl
*.joblib
*.h5
*.onnx

# --- Secrets ---
# Nothing here is currently tracked, but credentials near an MT5 login
# are worth excluding before they can be added by accident.
.env
.env.*
*credentials*.json
*serviceAccount*.json
secrets.*

# --- Logs ---
*.log
logs/

# --- Editor and OS noise ---
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Model governance runtime state (A/B counters, version registries).
# Machine-local operational state, not source: committing it would let one
# machine's A/B counters and rollback history overwrite every other's.
ai_governance/
easytradifyPythonBot/ai_governance/
